#!/usr/bin/env bash
set -e
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIR="$PWD"
NAME="${1:-${SESSION:-$(basename "$PWD")}}"
STATE="${CARDPUTERME_DIR:-$HOME/.cardputerme}"
mkdir -p "$STATE"
PID_FILE="$STATE/$NAME.pid"
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  echo "cardputerme — '$NAME' is already exposed (pick it on the Cardputer)"
  exit 0
fi
case "$(uname -s)" in
  Darwin) OS=darwin ;;
  Linux) OS=linux ;;
  *) OS="" ;;
esac
case "$(uname -m)" in
  arm64|aarch64) ARCH=arm64 ;;
  x86_64|amd64) ARCH=amd64 ;;
  *) ARCH="" ;;
esac
PREBUILT="$ROOT/dist/cardputerme-$OS-$ARCH"
if [ -n "$OS" ] && [ -n "$ARCH" ] && [ -x "$PREBUILT" ]; then
  BIN="$PREBUILT"
elif command -v go >/dev/null 2>&1; then
  (cd "$ROOT/server-go" && go build -o cardputerme ./cmd/cardputerme)
  BIN="$ROOT/server-go/cardputerme"
else
  echo "cardputerme — no prebuilt binary for $OS/$ARCH and Go is not installed." >&2
  echo "  install Go, or drop a release binary at $PREBUILT" >&2
  exit 1
fi
SESSION="$NAME" SESSION_CWD="$DIR" nohup "$BIN" >>"$STATE/$NAME.log" 2>&1 &
echo "$!" >"$PID_FILE"
echo "cardputerme — exposing '$NAME' (find it on the Cardputer) | log: $STATE/$NAME.log"
