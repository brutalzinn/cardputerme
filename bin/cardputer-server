#!/usr/bin/env bash
set -e
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
DIR="$PWD"
if ! command -v tmux >/dev/null 2>&1; then
  echo "cardputerme — tmux is not installed." >&2
  echo "  cardputerme captures your terminal through tmux and cannot run without it." >&2
  echo "  install it:  brew install tmux   (macOS)   |   sudo apt install tmux   (Ubuntu)" >&2
  exit 1
fi
NAME="${1:-${NAME:-$(basename "$PWD")}}"
SESSION="${SESSION:-$(tmux display-message -p '#{session_name}' 2>/dev/null || echo "$NAME")}"
if [ -z "$TMUX" ]; then
  echo "cardputerme — this terminal is not inside tmux, so there is nothing to mirror yet." >&2
  echo "  exposing a NEW empty terminal named '$NAME'." >&2
  echo "  to mirror the terminal you are working in, start it inside tmux:  tmux new -s $NAME" >&2
fi
STATE="${CARDPUTERME_DIR:-$HOME/.cardputerme}"
mkdir -p "$STATE"
PID_FILE="$STATE/server.pid"
PORT_FILE="$STATE/server.port"

# ONE server per machine owns many sessions, so first try to ATTACH this
# terminal to a server that is already running. Starting a second one is what
# used to leave stale, mismatched-version exposures around.
attach() {
  [ -f "$PORT_FILE" ] || return 1
  command -v curl >/dev/null 2>&1 || return 1
  port="$(tr -dc '0-9' <"$PORT_FILE")"
  [ -n "$port" ] || return 1
  curl -fsS --max-time 2 "http://127.0.0.1:$port/health" >/dev/null 2>&1 || return 1
  curl -fsS --max-time 5 -X POST "http://127.0.0.1:$port/sessions" \
    -H 'Content-Type: application/json' \
    -d "{\"name\":\"$NAME\",\"session\":\"$SESSION\",\"cwd\":\"$DIR\"}" >/dev/null 2>&1 || return 1
  echo "cardputerme — '$NAME' attached to the server on port $port (pick it on the Cardputer)"
  return 0
}
if attach; then
  exit 0
fi
case "$(uname -s)" in
  Darwin) OS=darwin ;;
  Linux) OS=linux ;;
  *) OS="" ;;
esac
case "$(uname -m)" in
  arm64|aarch64) ARCH=arm64 ;;
  x86_64|amd64) ARCH=amd64 ;;
  *) ARCH="" ;;
esac
PREBUILT="$ROOT/dist/cardputerme-$OS-$ARCH"
if [ -n "$CARDPUTERME_BIN" ] && [ -x "$CARDPUTERME_BIN" ]; then
  BIN="$CARDPUTERME_BIN"
elif [ -x "$HERE/cardputerme-server" ]; then
  BIN="$HERE/cardputerme-server"
elif command -v cardputerme-server >/dev/null 2>&1; then
  BIN="$(command -v cardputerme-server)"
elif [ -n "$OS" ] && [ -n "$ARCH" ] && [ -x "$PREBUILT" ]; then
  BIN="$PREBUILT"
elif command -v go >/dev/null 2>&1 && [ -d "$ROOT/server-go" ]; then
  (cd "$ROOT/server-go" && go build -o cardputerme ./cmd/cardputerme)
  BIN="$ROOT/server-go/cardputerme"
else
  echo "cardputerme — no cardputerme-server binary for $OS/$ARCH on PATH." >&2
  echo "  install it: curl -fsSL https://raw.githubusercontent.com/brutalzinn/cardputerme/main/install.sh | sh" >&2
  exit 1
fi
LOG="$STATE/server.log"
SESSION_CWD="$DIR" SESSION="$SESSION" nohup "$BIN" "$NAME" >>"$LOG" 2>&1 &
echo "$!" >"$PID_FILE"
echo "cardputerme — started the server and exposed '$NAME' (find it on the Cardputer) | log: $LOG"
