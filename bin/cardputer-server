#!/usr/bin/env bash
# cardputerme — expose this machine's terminal sessions to the Cardputer.
#   cardputerme            (via the shell alias)  -> sessions auto-discovered
#   cardputerme <name>                            -> expose a session by name
# The Cardputer connects over WebSocket and drives whatever runs inside —
# you never need to know (or care) how the session is hosted.
set -e
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT/server"
[ -d node_modules ] || npm install --no-audit --no-fund
exec node server.js
