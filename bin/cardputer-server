#!/usr/bin/env bash
set -e
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
DIR="$PWD"
NAME="${1:-${NAME:-$(basename "$PWD")}}"
TMUX_SESSION="${TMUX_SESSION:-$(tmux display-message -p '#{session_name}' 2>/dev/null || echo "$NAME")}"
STATE="${CARDPUTERME_DIR:-$HOME/.cardputerme}"
mkdir -p "$STATE"
PID_FILE="$STATE/$NAME.pid"
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  echo "cardputerme — '$NAME' is already exposed (pick it on the Cardputer)"
  exit 0
fi
case "$(uname -s)" in
  Darwin) OS=darwin ;;
  Linux) OS=linux ;;
  *) OS="" ;;
esac
case "$(uname -m)" in
  arm64|aarch64) ARCH=arm64 ;;
  x86_64|amd64) ARCH=amd64 ;;
  *) ARCH="" ;;
esac
PREBUILT="$ROOT/dist/cardputerme-$OS-$ARCH"
if [ -n "$CARDPUTERME_BIN" ] && [ -x "$CARDPUTERME_BIN" ]; then
  BIN="$CARDPUTERME_BIN"
elif [ -x "$HERE/cardputerme-server" ]; then
  BIN="$HERE/cardputerme-server"
elif command -v cardputerme-server >/dev/null 2>&1; then
  BIN="$(command -v cardputerme-server)"
elif [ -n "$OS" ] && [ -n "$ARCH" ] && [ -x "$PREBUILT" ]; then
  BIN="$PREBUILT"
elif command -v go >/dev/null 2>&1 && [ -d "$ROOT/server-go" ]; then
  (cd "$ROOT/server-go" && go build -o cardputerme ./cmd/cardputerme)
  BIN="$ROOT/server-go/cardputerme"
else
  echo "cardputerme — no cardputerme-server binary for $OS/$ARCH on PATH." >&2
  echo "  install it: curl -fsSL https://raw.githubusercontent.com/brutalzinn/cardputerme/main/install.sh | sh" >&2
  exit 1
fi
SESSION_CWD="$DIR" TMUX_SESSION="$TMUX_SESSION" nohup "$BIN" "$NAME" >>"$STATE/$NAME.log" 2>&1 &
echo "$!" >"$PID_FILE"
echo "cardputerme — exposing '$NAME' (find it on the Cardputer) | log: $STATE/$NAME.log"
