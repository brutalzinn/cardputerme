#!/usr/bin/env bash
set -e
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIR="$PWD"
NAME="${1:-${SESSION:-$(basename "$PWD")}}"
STATE="${CARDPUTERME_DIR:-$HOME/.cardputerme}"
mkdir -p "$STATE"
PID_FILE="$STATE/$NAME.pid"
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  echo "cardputerme — '$NAME' is already exposed (pick it on the Cardputer)"
  exit 0
fi
cd "$ROOT/server"
[ -d node_modules ] || npm install --no-audit --no-fund >/dev/null 2>&1
SESSION="$NAME" SESSION_CWD="$DIR" nohup node server.js >>"$STATE/$NAME.log" 2>&1 &
echo "$!" >"$PID_FILE"
echo "cardputerme — exposing '$NAME' (find it on the Cardputer) | log: $STATE/$NAME.log"
