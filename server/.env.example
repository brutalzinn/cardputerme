# Server settings. Copy to `.env` and adjust. `npm start` loads it automatically.

# Port the Cardputer connects to (WebSocket + HTTP share it).
PORT=4711

# tmux session where your Claude Code runs (tmux new -s claude; then run claude).
TMUX_SESSION=claude

# Card layout (WRAP_COLS must match the firmware .env WRAP_COLS).
WRAP_COLS=20
LINES_PER_CARD=7
SCROLLBACK_LINES=200
MAX_CARDS=40

# Read mode: "claude" = clean transcript reply (recommended) | "raw" = tmux screen.
READ_MODE=claude

# Play a notification sound on the Cardputer when Claude replies / asks (1=on, 0=off).
NOTIFY=1

# (Optional) Pin the transcript location. Leave BOTH unset and the server
# auto-follows the newest transcript across all ~/.claude* accounts — just start
# your `claude` session in any project folder and it's picked up automatically.
# CLAUDE_PROJECTS_DIR=/Users/you/.claude-account2/projects
# CLAUDE_PROJECT=
