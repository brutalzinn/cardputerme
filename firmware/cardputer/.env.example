# Firmware settings — injected into the build at `pio run -t upload`.
# Copy to `.env` and fill in. Keeps secrets out of source (main.cpp).

WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASS=YOUR_WIFI_PASSWORD

# Device columns for text wrapping.
WRAP_COLS=20

# No server IP/port here — the Cardputer discovers exposed terminals
# automatically over the LAN (UDP beacon on port 8000) and lets you pick one.
