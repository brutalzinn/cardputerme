# Firmware settings — injected into the build at `pio run -t upload`.
# Copy to `.env` and fill in. Keeps secrets out of source (main.cpp).

WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASS=YOUR_WIFI_PASSWORD

# Mac Mini LAN IP + port running the server (WS_HOST is an IP, no http://).
WS_HOST=192.168.0.149
WS_PORT=4711

# Must match the server .env WRAP_COLS.
WRAP_COLS=20
